NODE_ENV=development
PORT=5000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only needed for `npm run db:bootstrap` script
SUPABASE_DB_URL=

# Admin / system
# Legacy only: deprecated for admin RBAC endpoints (JWT is now required)
ADMIN_API_KEY=
REVIEW_TOKEN_SECRET=
APP_JWT_SECRET=
APP_ENCRYPTION_SECRET=

# Auth security controls
ACCESS_TOKEN_TTL_MINUTES=30
ADMIN_IDLE_TIMEOUT_MINUTES=20
STANDARD_IDLE_TIMEOUT_MINUTES=240
ADMIN_SESSION_TTL_HOURS=12
STANDARD_SESSION_TTL_DAYS=30
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_LOCK_THRESHOLD=5
AUTH_LOCK_MINUTES=15
AUTH_SUSPICIOUS_THRESHOLD=3
AUTH_CAPTCHA_REQUIRED_MINUTES=60
HCAPTCHA_SECRET=
AUTH_REQUIRE_EMAIL_VERIFICATION=true
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=12
PASSWORD_HISTORY_DEPTH=5
MFA_EMAIL_OTP_TTL_MINUTES=10
MFA_EMAIL_OTP_MAX_ATTEMPTS=5
AUTH_DEFAULT_REDIRECT_URL=http://localhost:3000/auth/callback

# Lead pricing defaults (USD)
LEAD_PRICE_LOW=8
LEAD_PRICE_MEDIUM=20
LEAD_PRICE_HIGH=45
